# Connexion PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travel_board?schema=public"

# Secret de signature des sessions (JWT). Générez-en un avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
# Origine du front (utile si le front appelle l'API directement plutôt que via le proxy Next.js)
CLIENT_ORIGIN="https://notebook.lionelkg.com"
# Dossier où sont stockées les photos envoyées
UPLOAD_DIR="./uploads"
# Nombre de proxies devant l'API (sert à retrouver l'IP réelle pour le rate-limit de connexion).
# En production : le front relaie /api vers https://api-notebook.lionelkg.com,
# donc la requête passe par reverse proxy du front → Next.js → reverse proxy de l'API : mettre 2.
TRUST_PROXY=1

# --- Exemple de fichier .env de production (sur le VPS) ---
# NODE_ENV=production
# DATABASE_URL="postgresql://USER:MDP@notebook-db:5432/travel_board?schema=public"
# JWT_SECRET="<64+ caractères aléatoires>"
# CLIENT_ORIGIN="https://notebook.lionelkg.com"
# TRUST_PROXY=2
